        <target>GitHub не зміг завантажити цей ресурс: {0}</target>
      </trans-unit>
      <trans-unit id="github.failure.unavailable">
        <source xml:lang="en">Not available</source>
        <target>Недоступно</target>
      </trans-unit>
      <trans-unit id="github.issue.ariaLabel">
