        <source xml:lang="en">Pull request {0} slash {1} number {2}, {3}, {4}: {5}</source>
        <target>Запит на злиття {0} коса {1} номер {2}, {3}, {4}: {5}</target>
      </trans-unit>
      <trans-unit id="github.repository.ariaLabel">
        <source xml:lang="en">GitHub repository {0} slash {1}</source>
        <target>GitHub репозиторій {0} слеш {1}</target>
      </trans-unit>
