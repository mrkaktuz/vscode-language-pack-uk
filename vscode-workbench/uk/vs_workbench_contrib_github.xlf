        <source xml:lang="en">Closed</source>
        <target>Закрито</target>
      </trans-unit>
      <trans-unit id="github.status.draft">
        <source xml:lang="en">Draft</source>
        <target>Чернетка</target>
      </trans-unit>
      <trans-unit id="github.status.merged">
        <source xml:lang="en">Merged</source>
        <target>Об'єднано</target>
      </trans-unit>
      <trans-unit id="github.status.notPlanned">
        <source xml:lang="en">Not planned</source>
        <target>Не заплановано</target>
      </trans-unit>
      <trans-unit id="github.status.open">
        <source xml:lang="en">Open</source>
        <target>Відкрити</target>
      </trans-unit>
    </body>
