        <target>Відкинути зміни до цього зображення?</target>
      </trans-unit>
      <trans-unit id="discardMarkUpButton">
        <source xml:lang="en">&amp;&amp;Discard</source>
        <note>&amp;&amp; denotes a mnemonic</note>
        <target>&amp;&amp;Відкинути</target>
      </trans-unit>
      <trans-unit id="discardMarkUpDetail">
        <source xml:lang="en">Your changes will be lost.</source>
        <target>Ваші зміни будуть втрачені.</target>
      </trans-unit>
      <trans-unit id="editImage">
        <source xml:lang="en">Edit Image</source>
        <target>Редагувати зображення</target>
      </trans-unit>
      <trans-unit id="editScreenshot">
        <source xml:lang="en">Edit Screenshot</source>
        <target>Редагувати скріншот</target>
      </trans-unit>
      <trans-unit id="screenshot">
        <source xml:lang="en">Screenshot</source>
        <target>Скриншот</target>
      </trans-unit>
      <trans-unit id="screenshotCancelled">
        <source xml:lang="en">Screenshot cancelled.</source>
        <target>Скріншот скасовано.</target>
      </trans-unit>
      <trans-unit id="screenshotCaptured">
        <source xml:lang="en">Screenshot captured.</source>
        <target>Скріншот захоплено.</target>
      </trans-unit>
      <trans-unit id="screenshotFailed">
        <source xml:lang="en">The screenshot could not be captured.</source>
        <target>Скріншот не вдалося захопити.</target>
      </trans-unit>
      <trans-unit id="screenshotModeAnnouncement">
        <source xml:lang="en">Screenshot mode. {0}</source>
        <target>Режим знімка екрану. {0}</target>
      </trans-unit>
      <trans-unit id="screenshotModeAnnouncementWithHelp">
        <source xml:lang="en">{0} Use {1} for accessibility help.</source>
        <target>{0} Використовуйте {1} для допомоги з доступністю.</target>
      </trans-unit>
    </body>
