  <file original="src/vs/workbench/contrib/screenshotTool/browser/screenshotSelection" source-language="en" datatype="plaintext" target-language="uk">
    <body>
      <trans-unit id="screenshotSelectionHint">
        <source xml:lang="en">Click to capture the window, or drag to capture an area. Press Enter to capture the window or Escape to cancel.</source>
        <target>Натисніть, щоб захопити вікно, або перетягніть, щоб захопити область. Натисніть Enter, щоб захопити вікно, або Escape, щоб скасувати.</target>
      </trans-unit>
      <trans-unit id="screenshotTool">
        <source xml:lang="en">Screenshot</source>
        <target>Знімок екрану</target>
      </trans-unit>
    </body>
  </file>
