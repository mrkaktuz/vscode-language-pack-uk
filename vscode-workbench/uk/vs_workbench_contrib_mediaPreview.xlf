  <file original="src/vs/workbench/contrib/mediaPreview/browser/activeMediaPreview" source-language="en" datatype="plaintext" target-language="uk">
    <body>
      <trans-unit id="activeImagePreview">
        <source xml:lang="en">Whether the active editor, or the focused side of the active diff editor, is an image preview</source>
        <target>Чи є активний редактор, або фокусована сторона активного редактора відмінностей, попереднім переглядом зображення</target>
      </trans-unit>
    </body>
  </file>
  <file original="src/vs/workbench/contrib/mediaPreview/browser/imagePreviewEditor" source-language="en" datatype="plaintext" target-language="uk">
    <body>
      <trans-unit id="imagePreview.ariaLabel">
        <source xml:lang="en">Image Preview: {0}</source>
        <target>Попередній перегляд зображення: {0}</target>
      </trans-unit>
      <trans-unit id="imagePreview.gitLfs">
        <source xml:lang="en">The image is stored with Git LFS and is not available for preview.</source>
        <target>Зображення зберігається з Git LFS і недоступне для попереднього перегляду.</target>
      </trans-unit>
      <trans-unit id="imagePreview.loadError">
        <source xml:lang="en">An error occurred while loading the image.</source>
        <target>Сталася помилка під час завантаження зображення.</target>
      </trans-unit>
      <trans-unit id="mediaPreview.openInTextEditor">
        <source xml:lang="en">Open in Text Editor</source>
        <target>Відкрити в текстовому редакторі</target>
      </trans-unit>
    </body>
  </file>
  <file original="src/vs/workbench/contrib/mediaPreview/browser/mediaPlayerEditorInput" source-language="en" datatype="plaintext" target-language="uk">
    <body>
      <trans-unit id="audioPreview.gitLfs">
        <source xml:lang="en">The audio file is stored with Git LFS and is not available for preview.</source>
        <target>Аудіофайл зберігається з Git LFS і недоступний для попереднього перегляду.</target>
      </trans-unit>
      <trans-unit id="audioPreview.loadError">
        <source xml:lang="en">An error occurred while loading the audio file.</source>
        <target>Виникла помилка під час завантаження аудіофайлу.</target>
      </trans-unit>
      <trans-unit id="mediaPreview.openInTextEditor">
        <source xml:lang="en">Open in Text Editor</source>
        <target>Відкрити в текстовому редакторі</target>
      </trans-unit>
      <trans-unit id="videoPreview.gitLfs">
        <source xml:lang="en">The video file is stored with Git LFS and is not available for preview.</source>
        <target>Відеофайл зберігається за допомогою Git LFS і недоступний для попереднього перегляду.</target>
      </trans-unit>
      <trans-unit id="videoPreview.loadError">
        <source xml:lang="en">An error occurred while loading the video file.</source>
        <target>Сталася помилка під час завантаження відеофайлу.</target>
      </trans-unit>
    </body>
  </file>
