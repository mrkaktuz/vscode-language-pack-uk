  <file original="src/vs/workbench/contrib/workspaces/browser/workspaces.contribution" source-language="en" datatype="plaintext" target-language="uk">
    <body>
      <trans-unit id="alreadyOpen">
        <source xml:lang="en">This workspace is already open.</source>
        <target>Цей робочий простір вже відкритий.</target>
      </trans-unit>
      <trans-unit id="foundWorkspaceLinked">
        <source xml:lang="en">This folder contains a workspace file '{0}'. Do you want to open it? {1} about workspace files.</source>
        <target>Ця папка містить файл робочого простору '{0}'. Ви хочете його відкрити? {1} про файли робочого простору.</target>
      </trans-unit>
      <trans-unit id="foundWorkspacesLinked">
        <source xml:lang="en">This folder contains multiple workspace files. Do you want to open one? {0} about workspace files.</source>
        <target>Ця папка містить кілька файлів робочого простору. Ви хочете відкрити один? {0} про файли робочого простору.</target>
      </trans-unit>
      <trans-unit id="openWorkspace">
        <source xml:lang="en">Open Workspace</source>
        <target>Відкрити Робочий Простір</target>
      </trans-unit>
      <trans-unit id="selectToOpen">
        <source xml:lang="en">Select a workspace to open</source>
        <target>Виберіть робочий простір для відкриття</target>
      </trans-unit>
      <trans-unit id="selectWorkspace">
        <source xml:lang="en">Select Workspace</source>
        <target>Виберіть робочий простір</target>
      </trans-unit>
      <trans-unit id="workspaceFilesLearnMore">
        <source xml:lang="en">Learn more</source>
        <target>Дізнатися більше</target>
      </trans-unit>
    </body>
