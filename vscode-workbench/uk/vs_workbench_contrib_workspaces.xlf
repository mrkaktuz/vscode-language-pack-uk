  <file original="src/vs/workbench/contrib/workspaces/browser/folderLocationExplorerBadge" source-language="en" datatype="plaintext" target-language="uk">
    <body>
      <trans-unit id="folderLocationBadge">
        <source xml:lang="en">'{0}' is open at {1}</source>
        <target>'{0}' відкрито о {1}</target>
      </trans-unit>
      <trans-unit id="folderLocationBadgeMultiple">
        <source xml:lang="en">{0} folders are at another location</source>
        <target>{0} папок знаходяться в іншому місці</target>
      </trans-unit>
    </body>
  </file>
  <file original="src/vs/workbench/contrib/workspaces/browser/folderLocationStatusBar" source-language="en" datatype="plaintext" target-language="uk">
    <body>
      <trans-unit id="currentLocation">
        <source xml:lang="en">Current</source>
        <target>Поточний</target>
      </trans-unit>
      <trans-unit id="currentLocationWithDescription">
        <source xml:lang="en">{0} (Current)</source>
        <target>{0} (Поточний)</target>
      </trans-unit>
      <trans-unit id="folderLocation">
        <source xml:lang="en">Folder Location</source>
        <target>Розташування папки</target>
      </trans-unit>
      <trans-unit id="folderLocationAria">
        <source xml:lang="en">Folder Location, {0}</source>
        <target>Розташування папки, {0}</target>
      </trans-unit>
      <trans-unit id="folderLocationCurrentItemAria">
        <source xml:lang="en">{0}, Current</source>
        <target>{0}, Поточний</target>
      </trans-unit>
      <trans-unit id="folderLocationIntroductionTitle">
        <source xml:lang="en">Folder Location</source>
        <target>Розташування папки</target>
      </trans-unit>
      <trans-unit id="folderLocationItemAria">
        <source xml:lang="en">{0}, {1}</source>
        <target>{0}, {1}</target>
      </trans-unit>
      <trans-unit id="folderLocationPickerAria">
        <source xml:lang="en">Folder Location</source>
        <target>Розташування папки</target>
      </trans-unit>
      <trans-unit id="folderLocationPrimaryTooltip">
        <source xml:lang="en">{0} (Switch Folder Location)</source>
        <target>{0} (Змінити місце розташування папки)</target>
      </trans-unit>
      <trans-unit id="folderLocationSwitched">
        <source xml:lang="en">The folder is now at the location '{0}'. Files, search, terminals and extensions use this location.</source>
        <target>Тепер папка знаходиться за адресою '{0}'. Файли, пошук, термінали та розширення використовують це місце.</target>
      </trans-unit>
      <trans-unit id="folderLocationTooltip">
        <source xml:lang="en">{0} (alternate location of '{1}')</source>
        <target>{0} (альтернативне місце розташування '{1}')</target>
