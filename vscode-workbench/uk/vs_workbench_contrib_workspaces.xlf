      <trans-unit id="gotIt">
        <source xml:lang="en">Got It</source>
        <target>Зрозумів</target>
      </trans-unit>
      <trans-unit id="returnToPrimaryFolderLocation">
        <source xml:lang="en">Return to Primary Location</source>
        <target>Повернутися до основного місця розташування</target>
      </trans-unit>
      <trans-unit id="switchFolderLocation">
        <source xml:lang="en">Switch Folder Location...</source>
        <target>Змінити місце розташування папки...</target>
      </trans-unit>
      <trans-unit id="switchFolderLocationPlaceholder">
        <source xml:lang="en">Select a Location for the Folder</source>
        <target>Виберіть місце для папки</target>
      </trans-unit>
