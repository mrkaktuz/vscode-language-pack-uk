  <file original="src/vs/workbench/contrib/multiDiffEditor/browser/multiDiffEditorInput" source-language="en" datatype="plaintext" target-language="uk">
    <body>
      <trans-unit id="name">
        <source xml:lang="en">Multi Diff Editor</source>
        <target>Мульти диф редактор</target>
      </trans-unit>
      <trans-unit id="nameWithFiles">
        <source xml:lang="en">{0} ({1} files)</source>
        <note>{0} is the name of the editor&#xD;
{1} is the number of files being shown</note>
        <target>{0} ({1} файлів)</target>
      </trans-unit>
      <trans-unit id="nameWithOneFile">
        <source xml:lang="en">{0} (1 file)</source>
        <note>{0} is the name of the editor</note>
        <target>{0} (1 файл)</target>
      </trans-unit>
    </body>
  </file>
  <file original="src/vs/workbench/contrib/multiDiffEditor/browser/scmMultiDiffSourceResolver" source-language="en" datatype="plaintext" target-language="uk">
    <body>
      <trans-unit id="openChanges">
        <source xml:lang="en">Open Changes</source>
        <target>Відкриті зміни</target>
      </trans-unit>
    </body>
  </file>
  <file original="src/vs/workbench/contrib/multiDiffEditor/common/multiDiffEditor" source-language="en" datatype="plaintext" target-language="uk">
    <body>
      <trans-unit id="multiDiffEditor.experimental.variant">
        <source xml:lang="en">Controls the experimental variant of the multi diff editor.</source>
        <target>Контролює експериментальний варіант багатофункціонального редактора дифів.</target>
      </trans-unit>
      <trans-unit id="multiDiffEditor.experimental.variant.cards">
        <source xml:lang="en">Use the compact card-based variant.</source>
        <target>Використовуйте компактний варіант на основі карток.</target>
      </trans-unit>
      <trans-unit id="multiDiffEditor.experimental.variant.noCards">
        <source xml:lang="en">Use the compact variant without cards.</source>
        <target>Використовуйте компактний варіант без карток.</target>
      </trans-unit>
      <trans-unit id="multiDiffEditorConfigurationTitle">
        <source xml:lang="en">Multi Diff Editor</source>
        <target>Мульти диф редактор</target>
      </trans-unit>
    </body>
  </file>
