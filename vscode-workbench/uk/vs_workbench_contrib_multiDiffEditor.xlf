  <file original="src/vs/workbench/contrib/multiDiffEditor/browser/actions" source-language="en" datatype="plaintext" target-language="uk">
    <body>
      <trans-unit id="ExpandAllDiffs">
        <source xml:lang="en">Expand All Diffs</source>
        <target>Розгорнути всі відмінності</target>
      </trans-unit>
      <trans-unit id="collapseAllDiffs">
        <source xml:lang="en">Collapse All Diffs</source>
        <target>Згорнути всі різниці</target>
      </trans-unit>
      <trans-unit id="diffView">
        <source xml:lang="en">Diff View</source>
        <target>Перегляд відмінностей</target>
      </trans-unit>
      <trans-unit id="goToFile">
        <source xml:lang="en">Open File</source>
        <target>Відкрити файл</target>
      </trans-unit>
      <trans-unit id="goToNextChange">
        <source xml:lang="en">Go to Next Change</source>
        <target>Перейти до наступної зміни</target>
      </trans-unit>
      <trans-unit id="goToPreviousChange">
        <source xml:lang="en">Go to Previous Change</source>
        <target>Перейти до попередньої зміни</target>
      </trans-unit>
      <trans-unit id="openMultiDiffEditorLayoutDebug">
        <source xml:lang="en">Open Multi Diff Editor Layout Debug State</source>
        <target>Відкрити макет редактора багатократних відмінностей стану налагодження</target>
      </trans-unit>
    </body>
  </file>
  <file original="src/vs/workbench/contrib/multiDiffEditor/browser/icons.contribution" source-language="en" datatype="plaintext" target-language="uk">
    <body>
      <trans-unit id="multiDiffEditorLabelIcon">
        <source xml:lang="en">Icon of the multi diff editor label.</source>
        <target>Іконка мітки багатофункціонального редактора.</target>
      </trans-unit>
    </body>
  </file>
