<?xml version="1.0" encoding="utf-8"?>
<xliff version="1.2" xmlns="urn:oasis:names:tc:xliff:document:1.2">
  <file original="src/vs/workbench/contrib/agentsVoice/browser/agentsVoice.contribution" source-language="en" datatype="plaintext" target-language="uk">
    <body>
      <trans-unit id="agents.voice.autoSendDelay">
        <source xml:lang="en">In toggle voice mode (short tap), automatically finish recording after this many milliseconds of silence. Set to -1 to disable.</source>
        <target>У режимі голосового перемикання (короткий дотик) автоматично завершити запис після цього часу мовчання в мілісекундах. Встановіть -1, щоб вимкнути.</target>
      </trans-unit>
      <trans-unit id="agents.voice.backendUrl">
        <source xml:lang="en">Voice backend WebSocket URL. Leave empty to use the default hosted backend. Set to e.g. `ws://localhost:8000/api/v1/realtime/voice` to point at a backend running on your machine.</source>
        <target>URL-адреса WebSocket для голосового бекенду. Залиште порожнім, щоб використовувати за замовчуванням хостований бекенд. Встановіть, наприклад, `ws://localhost:8000/api/v1/realtime/voice`, щоб вказати на бекенд, що працює на вашій машині.</target>
      </trans-unit>
      <trans-unit id="agents.voice.enabled">
        <source xml:lang="en">Enable the Voice Mode panel in the chat view for voice-driven coding conversations.</source>
        <target>Увімкніть панель режиму голосу у вікні чату для розмов про кодування з використанням голосу.</target>
      </trans-unit>
      <trans-unit id="agents.voice.sendKeyword">
        <source xml:lang="en">A keyword phrase (e.g. "send it") that, when spoken at the end of an utterance in toggle mode, triggers sending the request immediately. The keyword is stripped from the sent message. Leave empty to disable.</source>
        <target>Ключова фраза (наприклад, "надішліть це"), яка, коли її вимовляють в кінці висловлювання в режимі перемикання, миттєво активує відправлення запиту. Ключове слово видаляється з надісланого повідомлення. Залиште порожнім, щоб вимкнути.</target>
      </trans-unit>
      <trans-unit id="agents.voice.showTranscript">
        <source xml:lang="en">Show the voice transcript overlay in the chat input area while voice mode is active.</source>
        <target>Показати накладку транскрипції голосу в області введення чату, поки активний голосовий режим.</target>
      </trans-unit>
      <trans-unit id="agents.voice.textToSpeech">
        <source xml:lang="en">When enabled, the assistant reads responses aloud. When disabled, responses appear as text transcripts only.</source>
        <target>Коли увімкнено, асистент читає відповіді вголос. Коли вимкнено, відповіді з'являються лише у вигляді текстових транскриптів.</target>
      </trans-unit>
      <trans-unit id="agentsVoice.connecting">
        <source xml:lang="en">Connecting...</source>
        <target>Підключення...</target>
      </trans-unit>
      <trans-unit id="agentsVoice.disconnect">
        <source xml:lang="en">Disconnect Voice Mode</source>
        <target>Вимкнути голосовий режим</target>
      </trans-unit>
      <trans-unit id="agentsVoice.pttStopInChat">
        <source xml:lang="en">Voice Mode: Stop Recording</source>
        <target>Режим голосу: Зупинити запис</target>
      </trans-unit>
      <trans-unit id="agentsVoice.selectMicrophone">
        <source xml:lang="en">Voice: Select Microphone</source>
        <target>Голос: Виберіть мікрофон</target>
      </trans-unit>
      <trans-unit id="agentsVoice.simulateConnection">
        <source xml:lang="en">Voice: Simulate Connection (Dev)</source>
        <target>Голос: Симулювати з'єднання (Розробка)</target>
      </trans-unit>
      <trans-unit id="agentsVoice.startVoiceInChat">
        <source xml:lang="en">Voice Mode</source>
        <target>Режим голосу</target>
      </trans-unit>
      <trans-unit id="agentsVoiceConfigurationTitle">
        <source xml:lang="en">Voice Mode</source>
        <target>Режим голосу</target>
      </trans-unit>
      <trans-unit id="agentsVoicePushToTalk">
        <source xml:lang="en">Voice Mode: Push to Talk</source>
        <target>Режим голосу: Натисніть, щоб говорити</target>
      </trans-unit>
      <trans-unit id="current">
        <source xml:lang="en">(current)</source>
        <target>(поточний)</target>
      </trans-unit>
      <trans-unit id="noMicrophones">
        <source xml:lang="en">No microphones found</source>
        <target>Мікрофонів не знайдено</target>
      </trans-unit>
      <trans-unit id="resetAgentsVoiceOnboarding">
        <source xml:lang="en">Voice: Reset Onboarding</source>
        <target>Голос: Скинути введення в систему</target>
      </trans-unit>
      <trans-unit id="selectMic">
        <source xml:lang="en">Select a microphone for Voice Mode</source>
        <target>Виберіть мікрофон для голосового режиму</target>
      </trans-unit>
      <trans-unit id="systemDefault">
        <source xml:lang="en">System Default</source>
        <target>Системне значення за замовчуванням</target>
      </trans-unit>
      <trans-unit id="unknownDevice">
        <source xml:lang="en">Unknown Device ({0})</source>
        <target>Невідомий пристрій ({0})</target>
      </trans-unit>
    </body>
  </file>
  <file original="src/vs/workbench/contrib/agentsVoice/browser/transcriptsView/voiceTranscripts.contribution" source-language="en" datatype="plaintext" target-language="uk">
    <body>
      <trans-unit id="agentsVoice.showTranscripts">
        <source xml:lang="en">Show Voice Transcripts</source>
        <target>Показати транскрипції голосу</target>
      </trans-unit>
      <trans-unit id="agentsVoice.showTranscripts.menu">
        <source xml:lang="en">Show Voice Transcripts</source>
        <target>Показати транскрипції голосу</target>
      </trans-unit>
      <trans-unit id="agentsVoiceCategory">
        <source xml:lang="en">Agents Voice</source>
        <target>Голос агентів</target>
      </trans-unit>
      <trans-unit id="voiceTranscripts.archiveAll">
        <source xml:lang="en">Archive All</source>
        <target>Архівувати все</target>
      </trans-unit>
      <trans-unit id="voiceTranscripts.deleteAll">
        <source xml:lang="en">Delete All</source>
        <target>Видалити все</target>
      </trans-unit>
      <trans-unit id="voiceTranscripts.deleteAllConfirm">
        <source xml:lang="en">Delete all voice transcripts?</source>
        <target>Видалити всі транскрипції голосу?</target>
      </trans-unit>
      <trans-unit id="voiceTranscripts.deleteAllConfirmButton">
        <source xml:lang="en">Delete</source>
        <target>Видалити</target>
      </trans-unit>
      <trans-unit id="voiceTranscripts.deleteAllDetail">
        <source xml:lang="en">This permanently deletes the local transcript file for your user. There is no server-side copy.</source>
        <target>Це назавжди видаляє локальний файл транскрипції для вашого користувача. Серверної копії немає.</target>
      </trans-unit>
      <trans-unit id="voiceTranscripts.focus">
        <source xml:lang="en">Focus Voice Transcripts View</source>
        <target>Перегляд транскриптів голосу фокусу</target>
      </trans-unit>
      <trans-unit id="voiceTranscripts.refresh">
        <source xml:lang="en">Refresh</source>
        <target>Оновити</target>
      </trans-unit>
      <trans-unit id="voiceTranscriptsContainer">
        <source xml:lang="en">Voice Transcripts</source>
        <target>Транскрипти голосу</target>
      </trans-unit>
      <trans-unit id="voiceTranscriptsView">
        <source xml:lang="en">Voice Transcripts</source>
        <target>Транскрипти голосу</target>
      </trans-unit>
      <trans-unit id="voiceTranscriptsViewIcon">
        <source xml:lang="en">View icon of the Voice Transcripts view.</source>
        <target>Переглянути значок перегляду транскриптів голосу.</target>
      </trans-unit>
    </body>
  </file>
  <file original="src/vs/workbench/contrib/agentsVoice/browser/transcriptsView/voiceTranscriptsView" source-language="en" datatype="plaintext" target-language="uk">
