  <file original="src/vs/workbench/contrib/agentsVoice/browser/agentsVoice.contribution" source-language="en" datatype="plaintext" target-language="uk">
    <body>
      <trans-unit id="agents.voice.alwaysOnTop">
        <source xml:lang="en">Keep the Voice Mode window always on top of other windows.</source>
        <target>Залишайте вікно Режиму голосу завжди поверх інших вікон.</target>
      </trans-unit>
      <trans-unit id="agents.voice.backendUrl">
        <source xml:lang="en">Voice backend WebSocket URL. Leave empty to use the default hosted backend. Set to e.g. `ws://localhost:8000/api/v1/realtime/voice` to point at a backend running on your machine.</source>
        <target>URL-адреса WebSocket для голосового бекенду. Залиште порожнім, щоб використовувати за замовчуванням хостований бекенд. Встановіть, наприклад, `ws://localhost:8000/api/v1/realtime/voice`, щоб вказати на бекенд, що працює на вашій машині.</target>
      </trans-unit>
      <trans-unit id="agents.voice.enabled">
        <source xml:lang="en">Enable the Voice Mode panel in the chat view for voice-driven coding conversations.</source>
        <target>Увімкніть панель режиму голосу у вікні чату для розмов про кодування з використанням голосу.</target>
      </trans-unit>
      <trans-unit id="agents.voice.showTranscript">
        <source xml:lang="en">Show the voice transcript overlay in the chat input area while voice mode is active.</source>
        <target>Показати накладку транскрипції голосу в області введення чату, поки активний голосовий режим.</target>
      </trans-unit>
      <trans-unit id="agents.voice.textToSpeech">
        <source xml:lang="en">When enabled, the assistant reads responses aloud. When disabled, responses appear as text transcripts only.</source>
        <target>Коли увімкнено, асистент читає відповіді вголос. Коли вимкнено, відповіді з'являються лише у вигляді текстових транскриптів.</target>
      </trans-unit>
      <trans-unit id="agentsVoice.connecting">
        <source xml:lang="en">Connecting...</source>
        <target>Підключення...</target>
      </trans-unit>
      <trans-unit id="agentsVoice.disconnect">
        <source xml:lang="en">Disconnect Voice Mode</source>
        <target>Вимкнути голосовий режим</target>
      </trans-unit>
      <trans-unit id="agentsVoice.pttStopInChat">
        <source xml:lang="en">Voice Mode: Stop Recording</source>
        <target>Режим голосу: Зупинити запис</target>
      </trans-unit>
      <trans-unit id="agentsVoice.simulateConnection">
        <source xml:lang="en">Voice: Simulate Connection (Dev)</source>
        <target>Голос: Симулювати з'єднання (Розробка)</target>
      </trans-unit>
      <trans-unit id="agentsVoice.startVoiceInChat">
        <source xml:lang="en">Voice Mode</source>
        <target>Режим голосу</target>
      </trans-unit>
      <trans-unit id="agentsVoiceConfigurationTitle">
        <source xml:lang="en">Voice Mode</source>
        <target>Режим голосу</target>
      </trans-unit>
      <trans-unit id="agentsVoicePushToTalk">
        <source xml:lang="en">Voice Mode: Push to Talk</source>
        <target>Режим голосу: Натисніть, щоб говорити</target>
      </trans-unit>
      <trans-unit id="resetAgentsVoiceOnboarding">
        <source xml:lang="en">Voice: Reset Onboarding</source>
        <target>Голос: Скинути введення в систему</target>
      </trans-unit>
      <trans-unit id="toggleAgentsVoiceWindow">
        <source xml:lang="en">Voice Mode</source>
        <target>Режим голосу</target>
      </trans-unit>
    </body>
