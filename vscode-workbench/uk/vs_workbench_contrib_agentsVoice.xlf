      </trans-unit>
      <trans-unit id="voiceTranscripts.older">
        <source xml:lang="en">Older</source>
        <target>Старший</target>
      </trans-unit>
      <trans-unit id="voiceTranscripts.today">
        <source xml:lang="en">Today</source>
        <target>Сьогодні</target>
      </trans-unit>
      <trans-unit id="voiceTranscripts.yesterday">
        <source xml:lang="en">Yesterday</source>
        <target>Вчора</target>
      </trans-unit>
    </body>
