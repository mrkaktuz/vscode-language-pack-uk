  <file original="src/vs/workbench/services/workspaces/browser/abstractWorkspaceEditingService" source-language="en" datatype="plaintext" target-language="uk">
    <body>
      <trans-unit id="errorInvalidTaskConfiguration">
        <source xml:lang="en">Unable to write into workspace configuration file. Please open the file to correct errors/warnings in it and try again.</source>
        <target>Неможливо записати у файл конфігурації робочого простору. Будь ласка, відкрийте файл, щоб виправити помилки/попередження в ньому, і спробуйте ще раз.</target>
      </trans-unit>
      <trans-unit id="openWorkspaceConfigurationFile">
        <source xml:lang="en">Open Workspace Configuration</source>
        <target>Відкрити конфігурацію робочого простору</target>
      </trans-unit>
      <trans-unit id="save">
        <source xml:lang="en">Save</source>
        <target>Зберегти</target>
      </trans-unit>
      <trans-unit id="saveWorkspace">
        <source xml:lang="en">Save Workspace</source>
        <target>Зберегти робочу область</target>
      </trans-unit>
    </body>
  </file>
