  <file original="src/vs/workbench/contrib/surveys/browser/survey.contribution" source-language="en" datatype="plaintext" target-language="uk">
    <body>
      <trans-unit id="openSurvey">
        <source xml:lang="en">Open Survey</source>
        <target>Відкрити опитування</target>
      </trans-unit>
      <trans-unit id="survey.help.overview">
        <source xml:lang="en">You are in a survey form. Use Tab to move between questions and options.</source>
        <target>Ви на формі опитування. Використовуйте Tab для переміщення між питаннями та варіантами.</target>
      </trans-unit>
      <trans-unit id="survey.help.select">
        <source xml:lang="en">Use arrow keys within a question to navigate between options, and Space or Enter to select.</source>
        <target>Використовуйте стрілки на клавіатурі в межах запитання, щоб переміщатися між варіантами, та пробіл або Enter для вибору.</target>
      </trans-unit>
      <trans-unit id="survey.help.submit">
        <source xml:lang="en">Tab to the Submit button and press Enter once the required question is answered. Additional questions are optional.</source>
        <target>Перейдіть до кнопки "Відправити" за допомогою клавіші Tab і натисніть Enter після того, як буде відповідано на обов'язкове питання. Додаткові питання є необов'язковими.</target>
      </trans-unit>
      <trans-unit id="surveyEditorPaneTitle">
        <source xml:lang="en">Survey</source>
        <target>Опитування</target>
      </trans-unit>
    </body>
  </file>
  <file original="src/vs/workbench/contrib/surveys/browser/surveyEditorInput" source-language="en" datatype="plaintext" target-language="uk">
    <body>
      <trans-unit id="surveyIcon">
        <source xml:lang="en">Icon for the survey editor.</source>
        <target>Іконка для редактора опитувань.</target>
      </trans-unit>
    </body>
  </file>
  <file original="src/vs/workbench/contrib/surveys/browser/surveyEditorPane" source-language="en" datatype="plaintext" target-language="uk">
    <body>
      <trans-unit id="survey.pane.ariaLabel">
        <source xml:lang="en">Survey</source>
        <target>Опитування</target>
      </trans-unit>
      <trans-unit id="survey.questionOptional">
        <source xml:lang="en">{0} (optional)</source>
        <target>{0} (додатково)</target>
      </trans-unit>
      <trans-unit id="survey.submitFeedback">
        <source xml:lang="en">Submit feedback</source>
        <target>Надіслати відгук</target>
      </trans-unit>
      <trans-unit id="survey.submitHint">
        <source xml:lang="en">Answer the required question to submit</source>
        <target>Відповідьте на необхідне питання, щоб надіслати.</target>
      </trans-unit>
      <trans-unit id="survey.success.detail">
        <source xml:lang="en">Your answer helps us understand who needs this most. Thank you.</source>
        <target>Ваш відповідь допомагає нам зрозуміти, хто цього найбільше потребує. Дякуємо.</target>
      </trans-unit>
      <trans-unit id="survey.success.message">
        <source xml:lang="en">Response sent</source>
        <target>Відповідь надіслано</target>
      </trans-unit>
    </body>
  </file>
  <file original="src/vs/workbench/contrib/surveys/browser/surveyQuestions" source-language="en" datatype="plaintext" target-language="uk">
    <body>
      <trans-unit id="survey.copilotPmf.description">
        <source xml:lang="en">This short survey helps us understand how well Copilot fits into your workflow.</source>
        <target>Це коротке опитування допомагає нам зрозуміти, наскільки добре Copilot вписується у ваш робочий процес.</target>
      </trans-unit>
      <trans-unit id="survey.copilotPmf.q1">
        <source xml:lang="en">How disappointed would you be if you could no longer use Copilot?</source>
        <target>Наскільки ви були б розчаровані, якби більше не могли використовувати Copilot?</target>
      </trans-unit>
      <trans-unit id="survey.copilotPmf.q1.extremely">
        <source xml:lang="en">Extremely</source>
        <target>Надзвичайно</target>
      </trans-unit>
      <trans-unit id="survey.copilotPmf.q1.notAtAll">
        <source xml:lang="en">Not at all</source>
        <target>Зовсім ні</target>
      </trans-unit>
      <trans-unit id="survey.copilotPmf.q1.slightly">
        <source xml:lang="en">Slightly</source>
        <target>Трохи</target>
      </trans-unit>
      <trans-unit id="survey.copilotPmf.q1.somewhat">
        <source xml:lang="en">Somewhat</source>
        <target>Досить</target>
      </trans-unit>
      <trans-unit id="survey.copilotPmf.q1.very">
        <source xml:lang="en">Very</source>
        <target>Дуже</target>
      </trans-unit>
      <trans-unit id="survey.copilotPmf.q2">
        <source xml:lang="en">What has Copilot helped you with most recently?</source>
        <target>Чим найбільше вам допоміг Copilot нещодавно?</target>
      </trans-unit>
      <trans-unit id="survey.copilotPmf.q2.automating">
        <source xml:lang="en">Automating repetitive work</source>
        <target>Автоматизація рутинної роботи</target>
      </trans-unit>
      <trans-unit id="survey.copilotPmf.q2.gettingUnstuck">
        <source xml:lang="en">Getting unstuck on bugs</source>
        <target>Вибратися з багів</target>
      </trans-unit>
      <trans-unit id="survey.copilotPmf.q2.multiFile">
        <source xml:lang="en">Making multi-file changes</source>
        <target>Внесення змін у кількох файлах</target>
      </trans-unit>
      <trans-unit id="survey.copilotPmf.q2.noClearValue">
        <source xml:lang="en">I haven't gotten clear value yet</source>
        <target>Я ще не отримав чіткої цінності.</target>
      </trans-unit>
      <trans-unit id="survey.copilotPmf.q2.other">
        <source xml:lang="en">None of the above</source>
        <target>Ні один з наведених вище</target>
      </trans-unit>
      <trans-unit id="survey.copilotPmf.q2.planning">
        <source xml:lang="en">Planning an approach</source>
        <target>Планування підходу</target>
      </trans-unit>
      <trans-unit id="survey.copilotPmf.q2.reviewing">
        <source xml:lang="en">Improving or reviewing code</source>
        <target>Покращення або перегляд коду</target>
      </trans-unit>
      <trans-unit id="survey.copilotPmf.q2.shippingFaster">
        <source xml:lang="en">Shipping changes faster</source>
        <target>Доставка змінюється швидше</target>
      </trans-unit>
      <trans-unit id="survey.copilotPmf.q2.understanding">
        <source xml:lang="en">Understanding the codebase</source>
        <target>Розуміння кодової бази</target>
      </trans-unit>
      <trans-unit id="survey.copilotPmf.q3">
        <source xml:lang="en">What most gets in your way?</source>
        <target>Що найбільше заважає вам?</target>
      </trans-unit>
      <trans-unit id="survey.copilotPmf.q3.biggerTasks">
        <source xml:lang="en">Struggles with bigger tasks</source>
        <target>Боротьба з більшими завданнями</target>
      </trans-unit>
      <trans-unit id="survey.copilotPmf.q3.context">
        <source xml:lang="en">Missing repo or project context</source>
        <target>Відсутній контекст репозиторію або проєкту</target>
      </trans-unit>
      <trans-unit id="survey.copilotPmf.q3.cost">
        <source xml:lang="en">Limits, cost, or billing</source>
        <target>Обмеження, вартість або виставлення рахунків</target>
      </trans-unit>
      <trans-unit id="survey.copilotPmf.q3.other">
        <source xml:lang="en">None of the above</source>
        <target>Нічого з вищезазначеного</target>
      </trans-unit>
      <trans-unit id="survey.copilotPmf.q3.reviewingTime">
        <source xml:lang="en">Too much time reviewing</source>
        <target>Занадто багато часу на перегляд</target>
      </trans-unit>
      <trans-unit id="survey.copilotPmf.q3.security">
        <source xml:lang="en">Security or permissions friction</source>
        <target>Безпека або тертя прав доступу</target>
      </trans-unit>
      <trans-unit id="survey.copilotPmf.q3.setup">
        <source xml:lang="en">Setup or integrations are hard</source>
        <target>Налаштування або інтеграції складні</target>
      </trans-unit>
      <trans-unit id="survey.copilotPmf.q3.slow">
        <source xml:lang="en">Too slow / breaks flow</source>
        <target>Занадто повільно / порушує потік</target>
      </trans-unit>
      <trans-unit id="survey.copilotPmf.q3.steering">
        <source xml:lang="en">Too much steering needed</source>
        <target>Занадто багато керування потрібно</target>
      </trans-unit>
      <trans-unit id="survey.copilotPmf.q3.trust">
        <source xml:lang="en">Output is hard to trust</source>
        <target>Вихідні дані важко довіряти.</target>
      </trans-unit>
      <trans-unit id="survey.copilotPmf.q4">
        <source xml:lang="en">How long have you been programming?</source>
        <target>Як довго ви займаєтеся програмуванням?</target>
      </trans-unit>
      <trans-unit id="survey.copilotPmf.q4.10to19">
        <source xml:lang="en">10-19 yr</source>
        <target>10-19 р.</target>
      </trans-unit>
      <trans-unit id="survey.copilotPmf.q4.20plus">
        <source xml:lang="en">20+ yr</source>
        <target>20+ років</target>
      </trans-unit>
      <trans-unit id="survey.copilotPmf.q4.3to5">
        <source xml:lang="en">3-5 yr</source>
        <target>3-5 р.</target>
      </trans-unit>
      <trans-unit id="survey.copilotPmf.q4.6to9">
        <source xml:lang="en">6-9 yr</source>
        <target>6-9 р.</target>
      </trans-unit>
      <trans-unit id="survey.copilotPmf.q4.lessThan3">
        <source xml:lang="en">&lt;3 yr</source>
        <target>&lt;3 роки</target>
      </trans-unit>
      <trans-unit id="survey.copilotPmf.title">
        <source xml:lang="en">Help Us Improve GitHub Copilot</source>
        <target>Допоможіть нам покращити GitHub Copilot</target>
      </trans-unit>
    </body>
  </file>
