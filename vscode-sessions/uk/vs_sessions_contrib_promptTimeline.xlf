  <file original="src/vs/sessions/contrib/promptTimeline/browser/promptTimeline.contribution" source-language="en" datatype="plaintext" target-language="uk">
    <body>
      <trans-unit id="sessions.promptTimeline.rail">
        <source xml:lang="en">Controls whether the prompt timeline is shown next to the chat transcript in the Agents window.</source>
        <target>Контролює, чи відображається хронологія запитів поруч з транскриптом чату у вікні Агентів.</target>
      </trans-unit>
      <trans-unit id="sessions.promptTimeline.stickyHeader">
        <source xml:lang="en">Controls whether the current prompt is pinned to the top of the chat transcript while scrolling in the Agents window.</source>
        <target>Контролює, чи закріплено поточний запит вгорі чату під час прокручування в вікні Агентів.</target>
      </trans-unit>
    </body>
  </file>
  <file original="src/vs/sessions/contrib/promptTimeline/browser/promptTimelineActions" source-language="en" datatype="plaintext" target-language="uk">
    <body>
      <trans-unit id="promptTimeline.category">
        <source xml:lang="en">Chat</source>
        <target>Чат</target>
      </trans-unit>
      <trans-unit id="promptTimeline.emptyPrompt">
        <source xml:lang="en">(empty prompt)</source>
        <target>(порожній запит)</target>
      </trans-unit>
      <trans-unit id="promptTimeline.goToPrompt">
        <source xml:lang="en">Go to Prompt...</source>
        <target>Перейдіть до Prompt...</target>
      </trans-unit>
      <trans-unit id="promptTimeline.nFiles">
        <source xml:lang="en">{0} files</source>
        <target>{0} файлів</target>
      </trans-unit>
      <trans-unit id="promptTimeline.oneFile">
        <source xml:lang="en">1 file</source>
        <target>1 файл</target>
      </trans-unit>
      <trans-unit id="promptTimeline.pickPlaceholder">
        <source xml:lang="en">Go to a prompt in this chat</source>
        <target>Перейдіть до підказки в цьому чаті</target>
      </trans-unit>
      <trans-unit id="promptTimeline.statDetail">
        <source xml:lang="en">+{0} −{1} · {2}</source>
        <target>+{0} −{1} · {2}</target>
      </trans-unit>
    </body>
  </file>
