      <trans-unit id="promptTimeline.groupedCount">
        <source xml:lang="en">{0} prompts</source>
        <target>{0} підказки</target>
      </trans-unit>
      <trans-unit id="promptTimeline.nFiles">
        <source xml:lang="en">{0} files</source>
        <target>{0} файлів</target>
      </trans-unit>
      <trans-unit id="promptTimeline.noEdits">
        <source xml:lang="en">no edits</source>
        <target>без змін</target>
      </trans-unit>
      <trans-unit id="promptTimeline.oneFile">
        <source xml:lang="en">1 file</source>
        <target>1 файл</target>
      </trans-unit>
      <trans-unit id="promptTimeline.reviewChangesForPrompt">
        <source xml:lang="en">Review Changes for Prompt: {0}</source>
        <target>Переглянути зміни для запиту: {0}</target>
      </trans-unit>
    </body>
  </file>
