<xliff version="1.2" xmlns="urn:oasis:names:tc:xliff:document:1.2">
  <file original="src/vs/sessions/contrib/promptTimeline/browser/promptTimeline.contribution" source-language="en" datatype="plaintext" target-language="uk">
    <body>
      <trans-unit id="sessions.promptTimeline.rail">
        <source xml:lang="en">Controls whether the prompt timeline is shown next to the chat transcript in the Agents window.</source>
        <target>Контролює, чи відображається хронологія запитів поруч з транскриптом чату у вікні Агентів.</target>
      </trans-unit>
      <trans-unit id="sessions.promptTimeline.rail.dock">
        <source xml:lang="en">Show a minimal handle on the transcript's left edge that opens a list of prompts on hover.</source>
        <target>Показати мінімальну ручку на лівому краю транскрипту, яка відкриває список підказок при наведенні.</target>
      </trans-unit>
      <trans-unit id="sessions.promptTimeline.rail.off">
        <source xml:lang="en">Do not show the prompt timeline.</source>
        <target>Не показувати часову шкалу запитів.</target>
      </trans-unit>
      <trans-unit id="sessions.promptTimeline.rail.ruler">
        <source xml:lang="en">Show an overview ruler beside the transcript scrollbar that fans into prompt pills on engagement.</source>
        <target>Показати оглядову лінійку поруч зі смугою прокрутки транскрипту, яка розширюється в підказки про залучення.</target>
      </trans-unit>
      <trans-unit id="sessions.promptTimeline.stickyHeader">
        <source xml:lang="en">Controls whether the current prompt is pinned to the top of the chat transcript while scrolling in the Agents window.</source>
        <target>Контролює, чи закріплено поточний запит вгорі чату під час прокручування в вікні Агентів.</target>
      </trans-unit>
    </body>
  </file>
