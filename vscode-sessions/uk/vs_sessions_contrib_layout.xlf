  <file original="src/vs/sessions/contrib/layout/browser/baseSessionLayoutController" source-language="en" datatype="plaintext" target-language="uk">
    <body>
      <trans-unit id="agentSecondarySidebarToggleClosedIcon">
        <source xml:lang="en">Icon for the sessions secondary sidebar when closed.</source>
        <target>Іконка для вторинної бічної панелі сесій, коли вона закрита.</target>
      </trans-unit>
      <trans-unit id="agentSecondarySidebarToggleOpenIcon">
        <source xml:lang="en">Icon for the sessions secondary sidebar when open.</source>
        <target>Іконка для вторинної бічної панелі сесій, коли вона відкрита.</target>
      </trans-unit>
      <trans-unit id="openAndCloseSidePanel">
        <source xml:lang="en">Open/Show and Close/Hide the Side Panel (editor area and auxiliary bar)</source>
        <target>Відкрити/Показати та Закрити/Сховати Бічну Панель (область редактора та допоміжна панель)</target>
      </trans-unit>
      <trans-unit id="sidePanelHidden">
        <source xml:lang="en">Side Panel hidden</source>
        <target>Бічна панель прихована</target>
      </trans-unit>
      <trans-unit id="sidePanelVisible">
        <source xml:lang="en">Side Panel shown</source>
        <target>Бічна панель показана</target>
      </trans-unit>
      <trans-unit id="toggleSecondarySidebar">
        <source xml:lang="en">Toggle Side Panel</source>
        <target>Переключити бічну панель</target>
      </trans-unit>
    </body>
  </file>
