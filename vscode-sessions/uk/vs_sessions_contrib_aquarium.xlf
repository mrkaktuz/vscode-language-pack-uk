<?xml version="1.0" encoding="utf-8"?>
<xliff version="1.2" xmlns="urn:oasis:names:tc:xliff:document:1.2">
  <file original="src/vs/sessions/contrib/aquarium/browser/aquarium.contribution" source-language="en" datatype="plaintext" target-language="uk">
    <body>
      <trans-unit id="aquarium.simulateStreak">
        <source xml:lang="en">Simulate Fish Feeding Streak</source>
        <target>Симулювати серію годування риби</target>
      </trans-unit>
      <trans-unit id="aquarium.simulateStreak.alive">
        <source xml:lang="en">Alive streak</source>
        <target>Живий рядок</target>
      </trans-unit>
      <trans-unit id="aquarium.simulateStreak.aliveDetail">
        <source xml:lang="en">Show a live feeding streak in the toggle tooltip.</source>
        <target>Показати живу стрічку годування в підказці перемикача.</target>
      </trans-unit>
      <trans-unit id="aquarium.simulateStreak.clear">
        <source xml:lang="en">Clear streak</source>
        <target>Чітка смуга</target>
      </trans-unit>
      <trans-unit id="aquarium.simulateStreak.clearDetail">
        <source xml:lang="en">Remove all streak state.</source>
        <target>Видалити всі стани смуг.</target>
      </trans-unit>
      <trans-unit id="aquarium.simulateStreak.countInvalid">
        <source xml:lang="en">Enter a whole number greater than 0.</source>
        <target>Введіть ціле число більше 0.</target>
      </trans-unit>
      <trans-unit id="aquarium.simulateStreak.countPrompt">
        <source xml:lang="en">How many days should the streak be?</source>
        <target>Скільки днів має бути серія?</target>
      </trans-unit>
      <trans-unit id="aquarium.simulateStreak.died">
        <source xml:lang="en">Died streak (revivable)</source>
        <target>Смертельна смуга (можливо відновити)</target>
      </trans-unit>
      <trans-unit id="aquarium.simulateStreak.diedDetail">
        <source xml:lang="en">Park a died streak and offer the revival prompt.</source>
        <target>Паркуйте мертву смугу і запропонуйте підказку відновлення.</target>
      </trans-unit>
      <trans-unit id="aquarium.simulateStreak.placeholder">
        <source xml:lang="en">Pick a streak scenario to simulate</source>
        <target>Виберіть сценарій серії для симуляції</target>
      </trans-unit>
      <trans-unit id="sessions.developerJoy.enabled">
        <source xml:lang="en">Adds an easter egg to the Agents window.</source>
        <target>Додає пасхалку до вікна Агентів.</target>
      </trans-unit>
    </body>
  </file>
  <file original="src/vs/sessions/contrib/aquarium/browser/aquariumOverlay" source-language="en" datatype="plaintext" target-language="uk">
    <body>
      <trans-unit id="aquarium.hide">
        <source xml:lang="en">Hide Aquarium</source>
        <target>Сховати акваріум</target>
      </trans-unit>
      <trans-unit id="aquarium.hunger.happy">
        <source xml:lang="en">fish is happy</source>
        <target>риба щаслива</target>
      </trans-unit>
      <trans-unit id="aquarium.hunger.neutral">
        <source xml:lang="en">fish is getting hungry</source>
        <target>риба голоднішає</target>
      </trans-unit>
      <trans-unit id="aquarium.hunger.sad">
        <source xml:lang="en">fish is hungry</source>
        <target>риба голодна</target>
      </trans-unit>
      <trans-unit id="aquarium.hunger.verySad">
        <source xml:lang="en">fish is starving</source>
        <target>риба голодує</target>
      </trans-unit>
      <trans-unit id="aquarium.reviveBadge">
        <source xml:lang="en">{0} · Feed again to revive</source>
        <target>{0} · Підживіть знову, щоб відновити</target>
      </trans-unit>
      <trans-unit id="aquarium.reviveLabel.one">
        <source xml:lang="en">{0} — feed a fish to revive your {1} day streak</source>
        <target>{0} — підкорміть рибу, щоб відновити вашу {1} денну серію</target>
      </trans-unit>
      <trans-unit id="aquarium.reviveLabel.other">
        <source xml:lang="en">{0} — feed a fish to revive your {1} day streak</source>
        <target>{0} — підгодуйте рибу, щоб відновити вашу {1} денну серію</target>
      </trans-unit>
      <trans-unit id="aquarium.show">
        <source xml:lang="en">Show Aquarium</source>
        <target>Показати акваріум</target>
      </trans-unit>
      <trans-unit id="aquarium.streakLabel.one">
        <source xml:lang="en">{0} — {1} — {2} day feeding streak</source>
        <target>{0} — {1} — {2} днів безперервного годування</target>
      </trans-unit>
      <trans-unit id="aquarium.streakLabel.other">
        <source xml:lang="en">{0} — {1} — {2} days feeding streak</source>
        <target>{0} — {1} — {2} днів безперервного годування</target>
      </trans-unit>
    </body>
  </file>
