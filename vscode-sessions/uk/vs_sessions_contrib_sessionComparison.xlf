  <file original="src/vs/sessions/contrib/sessionComparison/browser/modelEvaluationTools" source-language="en" datatype="plaintext" target-language="uk">
    <body>
      <trans-unit id="evaluation.confirm.attempt">
        <source xml:lang="en">Attempt {0}</source>
        <target>Спроба {0}</target>
      </trans-unit>
      <trans-unit id="evaluation.confirm.branch">
        <source xml:lang="en">Base Branch:</source>
        <target>Базова гілка:</target>
      </trans-unit>
      <trans-unit id="evaluation.confirm.folderless">
        <source xml:lang="en">Each attempt runs in an independent chat with no workspace.</source>
        <target>Кожна спроба виконується в незалежному чаті без робочого простору.</target>
      </trans-unit>
      <trans-unit id="evaluation.confirm.inheritedPermission">
        <source xml:lang="en">{0} (inherited from this chat)</source>
        <target>{0} (успадковано з цього чату)</target>
      </trans-unit>
      <trans-unit id="evaluation.confirm.inheritedPermissions">
        <source xml:lang="en">Permissions are inherited from this chat.</source>
        <target>Дозволи успадковуються з цього чату.</target>
      </trans-unit>
      <trans-unit id="evaluation.confirm.judge">
        <source xml:lang="en">Judge</source>
        <target>Суддя</target>
      </trans-unit>
      <trans-unit id="evaluation.confirm.model">
        <source xml:lang="en">{0} ({1})</source>
        <target>{0} ({1})</target>
      </trans-unit>
      <trans-unit id="evaluation.confirm.noWorkspace">
        <source xml:lang="en">No workspace</source>
        <target>Немає робочого простору</target>
      </trans-unit>
      <trans-unit id="evaluation.confirm.participantPermission">
        <source xml:lang="en"> - {0}</source>
        <target>- {0}</target>
      </trans-unit>
      <trans-unit id="evaluation.confirm.permissions">
        <source xml:lang="en">Permissions:</source>
        <target>Дозволи:</target>
      </trans-unit>
      <trans-unit id="evaluation.confirm.scenario">
        <source xml:lang="en">Scenario</source>
        <target>Сценарій</target>
      </trans-unit>
      <trans-unit id="evaluation.confirm.synthesizer">
        <source xml:lang="en">Synthesizer (On Request)</source>
        <target>Синтезатор (На запит)</target>
      </trans-unit>
      <trans-unit id="evaluation.confirm.title">
        <source xml:lang="en">Create Model Comparison?</source>
        <target>Створити порівняння моделей?</target>
      </trans-unit>
      <trans-unit id="evaluation.confirm.workspace">
        <source xml:lang="en">Workspace:</source>
        <target>Робоча область:</target>
      </trans-unit>
      <trans-unit id="evaluation.confirm.worktrees">
        <source xml:lang="en">Each attempt runs in a separate worktree.</source>
        <target>Кожна спроба виконується в окремому робочому дереві.</target>
      </trans-unit>
      <trans-unit id="evaluation.create">
        <source xml:lang="en">Create Model Comparison</source>
        <target>Створити порівняння моделей</target>
      </trans-unit>
      <trans-unit id="evaluation.list">
        <source xml:lang="en">List Model Comparisons</source>
        <target>Список порівнянь моделей</target>
      </trans-unit>
      <trans-unit id="evaluation.models">
        <source xml:lang="en">Get Comparison Models</source>
        <target>Отримати моделі порівняння</target>
      </trans-unit>
      <trans-unit id="evaluation.read">
        <source xml:lang="en">Read Model Comparison</source>
        <target>Порівняння моделей читання</target>
      </trans-unit>
      <trans-unit id="evaluation.toolset">
        <source xml:lang="en">Evaluate models across comparison scenarios</source>
        <target>Оцінюйте моделі в різних сценаріях порівняння.</target>
      </trans-unit>
    </body>
  </file>
  <file original="src/vs/sessions/contrib/sessionComparison/browser/sessionComparison.contribution" source-language="en" datatype="plaintext" target-language="uk">
    <body>
      <trans-unit id="openSessionComparison">
        <source xml:lang="en">Open Attempt Comparison</source>
        <target>Відкрити порівняння спроб</target>
      </trans-unit>
    </body>
  </file>
  <file original="src/vs/sessions/contrib/sessionComparison/browser/sessionComparisonTool" source-language="en" datatype="plaintext" target-language="uk">
    <body>
      <trans-unit id="sessionComparison.readTool.displayName">
        <source xml:lang="en">Read Attempt Comparison</source>
        <target>Порівняння спроб читання</target>
      </trans-unit>
      <trans-unit id="sessionComparison.readTool.invocationMessage">
        <source xml:lang="en">Reading attempt comparison</source>
        <target>Порівняння спроб читання</target>
      </trans-unit>
      <trans-unit id="sessionComparison.readTool.pastTenseMessage">
        <source xml:lang="en">Read attempt comparison</source>
        <target>Порівняння спроб читання</target>
      </trans-unit>
      <trans-unit id="sessionComparison.readTool.userDescription">
        <source xml:lang="en">Read the attempts and evidence for an active comparison</source>
        <target>Прочитайте спроби та докази для активного порівняння.</target>
      </trans-unit>
      <trans-unit id="sessionComparison.tool.displayName">
        <source xml:lang="en">Complete Attempt Comparison</source>
        <target>Завершити порівняння спроб</target>
      </trans-unit>
      <trans-unit id="sessionComparison.tool.error">
        <source xml:lang="en">Attempt comparison submission failed</source>
        <target>Спроба порівняння подання не вдалася</target>
      </trans-unit>
      <trans-unit id="sessionComparison.tool.invocationMessage">
        <source xml:lang="en">Submitting attempt comparison</source>
        <target>Порівняння спроб подання</target>
      </trans-unit>
      <trans-unit id="sessionComparison.tool.pastTenseMessage">
        <source xml:lang="en">Submitted attempt comparison</source>
        <target>Порівняння поданих спроб</target>
      </trans-unit>
      <trans-unit id="sessionComparison.tool.result">
        <source xml:lang="en">Submitted attempt comparison</source>
        <target>Порівняння поданих спроб</target>
      </trans-unit>
      <trans-unit id="sessionComparison.tool.userDescription">
        <source xml:lang="en">Submit the judge's structured attempt comparison</source>
        <target>Надішліть структуроване порівняння спроби судді</target>
      </trans-unit>
      <trans-unit id="sessionComparison.toolSet.description">
        <source xml:lang="en">Compare implementation attempts</source>
        <target>Порівняти спроби реалізації</target>
      </trans-unit>
    </body>
  </file>
  <file original="src/vs/sessions/contrib/sessionComparison/browser/sessionComparisonViewService" source-language="en" datatype="plaintext" target-language="uk">
    <body>
      <trans-unit id="sessionComparison.missing">
        <source xml:lang="en">This comparison is no longer available.</source>
        <target>Це порівняння більше недоступне.</target>
      </trans-unit>
      <trans-unit id="sessionComparison.noAttempts">
        <source xml:lang="en">No comparison attempts are available to open.</source>
        <target>Немає доступних спроб порівняння для відкриття.</target>
      </trans-unit>
    </body>
