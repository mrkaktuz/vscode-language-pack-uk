  <file original="src/vs/sessions/contrib/editor/browser/editor.contribution" source-language="en" datatype="plaintext" target-language="uk">
    <body>
      <trans-unit id="addFileAsContext">
        <source xml:lang="en">Add File as Context</source>
        <target>Додати файл як контекст</target>
      </trans-unit>
      <trans-unit id="closeMainEditorPart">
        <source xml:lang="en">Close Editor Area</source>
        <target>Закрити область редактора</target>
      </trans-unit>
      <trans-unit id="maximizeMainEditorPart">
        <source xml:lang="en">Maximize Editor Area</source>
        <target>Максимізувати область редактора</target>
      </trans-unit>
      <trans-unit id="openEditorInModal">
        <source xml:lang="en">Open in Modal Editor</source>
        <target>Відкрити в модальному редакторі</target>
      </trans-unit>
      <trans-unit id="openModalEditorInEditor">
        <source xml:lang="en">Open in Editor Area</source>
        <target>Відкрити в зоні редактора</target>
      </trans-unit>
      <trans-unit id="pullEditorLeft">
        <source xml:lang="en">Show Secondary Side Bar</source>
        <target>Показати бокову панель вторинного рівня</target>
      </trans-unit>
      <trans-unit id="pushEditorRight">
        <source xml:lang="en">Push Editor Right</source>
        <target>Перемістити редактор вправо</target>
      </trans-unit>
      <trans-unit id="restoreMainEditorPart">
        <source xml:lang="en">Restore Editor Area</source>
        <target>Відновити область редактора</target>
      </trans-unit>
    </body>
