  <file original="src/vs/sessions/contrib/editor/browser/diffEditor.sessions.contribution" source-language="en" datatype="plaintext" target-language="uk">
    <body>
      <trans-unit id="sessions.diffEditor.wordWrap">
        <source xml:lang="en">Controls how diff editors in the Agents window wrap lines.</source>
        <target>Контролює, як редактори відмінностей у вікні Агентів обгортають рядки.</target>
      </trans-unit>
      <trans-unit id="sessions.diffEditor.wordWrap.inherit">
        <source xml:lang="en">Lines will wrap according to the {0} setting.</source>
        <target>Рядки будуть переноситися відповідно до налаштування {0}.</target>
      </trans-unit>
      <trans-unit id="sessions.diffEditor.wordWrap.off">
        <source xml:lang="en">Lines will never wrap.</source>
        <target>Рядки ніколи не будуть переноситися.</target>
      </trans-unit>
      <trans-unit id="sessions.diffEditor.wordWrap.on">
        <source xml:lang="en">Lines will wrap at the viewport width.</source>
        <target>Рядки будуть переноситися відповідно до ширини вікна перегляду.</target>
      </trans-unit>
      <trans-unit id="sessions.editor.wordWrap">
        <source xml:lang="en">Controls how code editors in the Agents window wrap lines.</source>
        <target>Контролює, як редактори коду у вікні Агентів обгортають рядки.</target>
      </trans-unit>
      <trans-unit id="sessions.editor.wordWrap.inherit">
        <source xml:lang="en">Lines will wrap according to the {0} setting.</source>
        <target>Рядки будуть обгортатися відповідно до налаштування {0}.</target>
      </trans-unit>
      <trans-unit id="sessions.editor.wordWrap.off">
        <source xml:lang="en">Lines will never wrap.</source>
        <target>Рядки ніколи не будуть переноситися.</target>
      </trans-unit>
      <trans-unit id="sessions.editor.wordWrap.on">
        <source xml:lang="en">Lines will wrap at the viewport width.</source>
        <target>Рядки будуть переноситися відповідно до ширини вікна перегляду.</target>
      </trans-unit>
    </body>
  </file>
