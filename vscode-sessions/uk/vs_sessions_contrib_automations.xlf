  <file original="src/vs/sessions/contrib/automations/browser/automationDialogService" source-language="en" datatype="plaintext" target-language="uk">
    <body>
      <trans-unit id="automation.dialog.cancel">
        <source xml:lang="en">Cancel</source>
        <target>Скасувати</target>
      </trans-unit>
      <trans-unit id="automation.dialog.captureError">
        <source xml:lang="en">The automation wasn't saved because its session configuration couldn't be captured. Check the provider connection and try again.</source>
        <target>Автоматизацію не було збережено, оскільки її конфігурацію сеансу не вдалося зафіксувати. Перевірте з'єднання з постачальником і спробуйте ще раз.</target>
      </trans-unit>
      <trans-unit id="automation.dialog.create">
        <source xml:lang="en">Create</source>
        <target>Створити</target>
      </trans-unit>
      <trans-unit id="automation.dialog.createDescription">
        <source xml:lang="en">Define a prompt that will run on a schedule against the selected target.</source>
        <target>Визначте запит, який буде виконуватись за розкладом щодо вибраної цілі.</target>
      </trans-unit>
      <trans-unit id="automation.dialog.createTitle">
        <source xml:lang="en">New automation</source>
        <target>Нова автоматизація</target>
      </trans-unit>
      <trans-unit id="automation.dialog.editDescription">
        <source xml:lang="en">Update the schedule, prompt, or run target for this automation.</source>
        <target>Оновіть розклад, підказку або ціль для цієї автоматизації.</target>
      </trans-unit>
      <trans-unit id="automation.dialog.editTitle">
        <source xml:lang="en">Edit automation</source>
        <target>Редагувати автоматизацію</target>
      </trans-unit>
      <trans-unit id="automation.dialog.save">
        <source xml:lang="en">Save</source>
        <target>Зберегти</target>
      </trans-unit>
      <trans-unit id="automation.dialog.saving">
        <source xml:lang="en">Saving…</source>
        <target>Збереження…</target>
      </trans-unit>
    </body>
  </file>
  <file original="src/vs/sessions/contrib/automations/browser/automationRunner" source-language="en" datatype="plaintext" target-language="uk">
    <body>
      <trans-unit id="automationDispatchFailed">
        <source xml:lang="en">Automation '{0}' did not start a session: {1}</source>
        <target>Автоматизація '{0}' не розпочала сесію: {1}</target>
      </trans-unit>
      <trans-unit id="automationDispatchNoSession">
        <source xml:lang="en">The Agent Host ended the run without a session.</source>
        <target>Агент-хост завершив виконання без сесії.</target>
      </trans-unit>
      <trans-unit id="automationHostLoadError">
        <source xml:lang="en">Automations from {0} could not be loaded. Reconnect to the Agent Host and try again.</source>
        <target>Автоматизації з {0} не вдалося завантажити. Перепідключіться до Агентського Хоста та спробуйте ще раз.</target>
      </trans-unit>
      <trans-unit id="automationHostLoading">
        <source xml:lang="en">Automations from {0} are still loading. Wait for loading to finish, then try again.</source>
        <target>Автоматизації з {0} все ще завантажуються. Зачекайте, поки завантаження завершиться, а потім спробуйте ще раз.</target>
      </trans-unit>
      <trans-unit id="automationHostNotConnected">
        <source xml:lang="en">Connect to this automation's Agent Host and try again.</source>
        <target>Підключіться до хоста агента цієї автоматизації та спробуйте ще раз.</target>
      </trans-unit>
      <trans-unit id="automationHostNotSelected">
        <source xml:lang="en">This automation has no Agent Host. Duplicate it and select an Agent Host.</source>
        <target>Ця автоматизація не має Агентського Хоста. Скопіюйте її та виберіть Агентський Хост.</target>
      </trans-unit>
      <trans-unit id="automationHostUnavailable">
        <source xml:lang="en">{0} is unavailable. Reconnect to the Agent Host and try again.</source>
        <target>{0} недоступний. Перепідключіться до Агентського Хоста та спробуйте ще раз.</target>
      </trans-unit>
      <trans-unit id="automationProviderUnsupported">
        <source xml:lang="en">{0} does not support automations. Use an Agent Host that supports automations.</source>
        <target>{0} не підтримує автоматизації. Використовуйте Agent Host, який підтримує автоматизації.</target>
      </trans-unit>
      <trans-unit id="automationRunFailed">
        <source xml:lang="en">Automation '{0}' failed: {1}</source>
        <target>Автоматизація '{0}' не вдалася: {1}</target>
      </trans-unit>
      <trans-unit id="automationRunUnavailable">
        <source xml:lang="en">The automation's Agent Host is not ready to run it.</source>
        <target>Агент-хост автоматизації не готовий до його виконання.</target>
      </trans-unit>
    </body>
  </file>
