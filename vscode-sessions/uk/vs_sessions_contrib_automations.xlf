  <file original="src/vs/sessions/contrib/automations/browser/automationDialog" source-language="en" datatype="plaintext" target-language="uk">
    <body>
      <trans-unit id="automation.form.branch.capabilityLoadingReason">
        <source xml:lang="en">Session capabilities are loading.</source>
        <target>Завантажуються можливості сесії.</target>
      </trans-unit>
      <trans-unit id="automation.form.branch.chooseReason">
        <source xml:lang="en">Choose the local branch to use as the Worktree base.</source>
        <target>Виберіть локальну гілку, яку використовувати як базу Worktree.</target>
      </trans-unit>
      <trans-unit id="automation.form.branch.detached">
        <source xml:lang="en">({0})</source>
        <target>({0})</target>
      </trans-unit>
      <trans-unit id="automation.form.branch.folderModeReason">
        <source xml:lang="en">Select Worktree to choose a branch.</source>
        <target>Виберіть Worktree, щоб обрати гілку.</target>
      </trans-unit>
      <trans-unit id="automation.form.branch.loadError">
        <source xml:lang="en">Unable to load branches</source>
        <target>Неможливо завантажити гілки</target>
      </trans-unit>
      <trans-unit id="automation.form.branch.loadErrorReason">
        <source xml:lang="en">Open the branch picker to retry loading local branches.</source>
        <target>Відкрийте вибір гілок, щоб повторити завантаження локальних гілок.</target>
      </trans-unit>
      <trans-unit id="automation.form.branch.loading">
        <source xml:lang="en">Loading branches…</source>
        <target>Завантаження гілок…</target>
      </trans-unit>
      <trans-unit id="automation.form.branch.loadingReason">
        <source xml:lang="en">Local branches are loading.</source>
        <target>Локальні гілки завантажуються.</target>
      </trans-unit>
      <trans-unit id="automation.form.branch.noBranches">
        <source xml:lang="en">No local branches</source>
        <target>Немає локальних гілок</target>
      </trans-unit>
      <trans-unit id="automation.form.branch.noBranchesReason">
        <source xml:lang="en">No local branches were found in this repository.</source>
        <target>У цьому репозиторії не знайдено локальних гілок.</target>
      </trans-unit>
      <trans-unit id="automation.form.branch.noFolderReason">
        <source xml:lang="en">Select a folder to determine its Git branch.</source>
        <target>Виберіть папку, щоб визначити її Git-гілку.</target>
      </trans-unit>
      <trans-unit id="automation.form.branch.noRepo">
        <source xml:lang="en">no git repo</source>
        <target>немає git репозиторію</target>
      </trans-unit>
      <trans-unit id="automation.form.branch.noRepoReason">
        <source xml:lang="en">No Git repository was found for the selected folder.</source>
        <target>Не було знайдено репозиторій Git для вибраної папки.</target>
      </trans-unit>
      <trans-unit id="automation.form.branch.select">
        <source xml:lang="en">Select branch</source>
        <target>Виберіть гілку</target>
      </trans-unit>
      <trans-unit id="automation.form.branch.unknown">
        <source xml:lang="en">—</source>
        <target>Вибачте, але ви не надали текст для перекладу. Будь ласка, надайте рядок, який потрібно перекласти.</target>
      </trans-unit>
      <trans-unit id="automation.form.branch.unsupportedReason">
        <source xml:lang="en">The selected session type does not support Worktree branch configuration.</source>
        <target>Вибраний тип сесії не підтримує конфігурацію гілки Worktree.</target>
      </trans-unit>
      <trans-unit id="automation.form.branchRequired">
        <source xml:lang="en">A branch is required for Worktree isolation.</source>
        <target>Для ізоляції Worktree потрібна гілка.</target>
      </trans-unit>
      <trans-unit id="automation.form.day">
        <source xml:lang="en">Day of week</source>
        <target>День тижня</target>
      </trans-unit>
      <trans-unit id="automation.form.enabled">
        <source xml:lang="en">Enabled (the scheduler runs this automation when due)</source>
        <target>Увімкнено (планувальник запускає цю автоматизацію, коли настає термін)</target>
      </trans-unit>
      <trans-unit id="automation.form.folderRequired">
        <source xml:lang="en">Workspace folder is required.</source>
        <target>Папка робочого простору є обов'язковою.</target>
      </trans-unit>
      <trans-unit id="automation.form.harnessChip.action">
        <source xml:lang="en">Automations Harness Chip</source>
        <target>Автоматизації Harness Chip</target>
      </trans-unit>
      <trans-unit id="automation.form.interval">
        <source xml:lang="en">Schedule</source>
        <target>Розклад</target>
      </trans-unit>
      <trans-unit id="automation.form.isolation.checkboxAriaLabel">
