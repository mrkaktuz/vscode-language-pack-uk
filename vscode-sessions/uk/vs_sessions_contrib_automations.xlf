        <source xml:lang="en">Session configuration options</source>
        <target>Опції конфігурації сесії</target>
      </trans-unit>
      <trans-unit id="automation.form.sessionConfigurationUnavailable">
        <source xml:lang="en">Session configuration unavailable</source>
        <target>Конфігурація сеансу недоступна</target>
      </trans-unit>
