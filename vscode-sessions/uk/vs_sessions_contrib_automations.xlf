        <target>Ізоляція робочого дерева</target>
      </trans-unit>
      <trans-unit id="automation.form.isolation.worktree">
        <source xml:lang="en">New Worktree</source>
        <target>Новий Worktree</target>
      </trans-unit>
      <trans-unit id="automation.form.isolation.worktreeNoFolder">
        <source xml:lang="en">Select a folder to use Worktree isolation.</source>
        <target>Виберіть папку для використання ізоляції Worktree.</target>
      </trans-unit>
      <trans-unit id="automation.form.isolation.worktreeUnavailable">
        <source xml:lang="en">Not supported by the selected session type</source>
        <target>Не підтримується вибраним типом сесії</target>
      </trans-unit>
      <trans-unit id="automation.form.isolationGroup.action">
        <source xml:lang="en">Automations Isolation Group</source>
        <target>Група ізоляції автоматизацій</target>
      </trans-unit>
      <trans-unit id="automation.form.name">
        <source xml:lang="en">Name</source>
        <target>Ім'я</target>
      </trans-unit>
      <trans-unit id="automation.form.namePlaceholder">
        <source xml:lang="en">e.g. Morning standup notes</source>
        <target>наприклад, нотатки ранкової наради</target>
      </trans-unit>
      <trans-unit id="automation.form.nameRequired">
        <source xml:lang="en">Name is required.</source>
        <target>Ім'я є обов'язковим.</target>
      </trans-unit>
      <trans-unit id="automation.form.noWorkspace">
        <source xml:lang="en">No workspace</source>
        <target>Немає робочого простору</target>
      </trans-unit>
      <trans-unit id="automation.form.noWorkspace.description">
        <source xml:lang="en">Run without a backing workspace</source>
        <target>Запустити без робочого простору</target>
      </trans-unit>
      <trans-unit id="automation.form.prompt">
        <source xml:lang="en">Prompt</source>
        <target>Запит</target>
      </trans-unit>
      <trans-unit id="automation.form.prompt.placeholder">
        <source xml:lang="en">Describe what you want to automate</source>
        <target>Опишіть, що ви хочете автоматизувати</target>
      </trans-unit>
      <trans-unit id="automation.form.promptRequired">
        <source xml:lang="en">Prompt is required.</source>
        <target>Підказка є обов'язковою.</target>
      </trans-unit>
      <trans-unit id="automation.form.sessionTypeRequired">
        <source xml:lang="en">Session type is required.</source>
        <target>Тип сесії є обов'язковим.</target>
      </trans-unit>
      <trans-unit id="automation.form.time">
        <source xml:lang="en">Time</source>
        <target>Час</target>
      </trans-unit>
      <trans-unit id="automation.form.workspacePicker.action">
        <source xml:lang="en">Automations Workspace Picker</source>
        <target>Вибір робочого простору автоматизацій</target>
      </trans-unit>
      <trans-unit id="automation.form.workspacePicker.pickAriaLabel">
        <source xml:lang="en">Pick a workspace for this automation</source>
        <target>Виберіть робочий простір для цієї автоматизації</target>
      </trans-unit>
      <trans-unit id="automation.form.workspacePicker.selectedAriaLabel">
        <source xml:lang="en">Automation target, {0}</source>
        <target>Автоматизаційна ціль, {0}</target>
      </trans-unit>
      <trans-unit id="automation.interval.daily">
        <source xml:lang="en">Daily</source>
        <target>Щоденно</target>
      </trans-unit>
      <trans-unit id="automation.interval.hourly">
        <source xml:lang="en">Hourly</source>
        <target>Годинний</target>
      </trans-unit>
      <trans-unit id="automation.interval.manual">
        <source xml:lang="en">Manual</source>
        <target>Посібник</target>
      </trans-unit>
      <trans-unit id="automation.interval.weekly">
        <source xml:lang="en">Weekly</source>
        <target>Щотижня</target>
      </trans-unit>
      <trans-unit id="pickWorkspace">
        <source xml:lang="en">workspace</source>
        <target>робоча область</target>
      </trans-unit>
