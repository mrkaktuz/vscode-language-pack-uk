  <file original="src/vs/sessions/contrib/chatWindow/browser/chatWindowComposer" source-language="en" datatype="plaintext" target-language="uk">
    <body>
      <trans-unit id="chatWindowComposer.backgroundSendFailed">
        <source xml:lang="en">Couldn't start the session: {0}</source>
        <target>Не вдалося розпочати сесію: {0}</target>
      </trans-unit>
      <trans-unit id="chatWindowComposer.backgroundSendFailedIn">
        <source xml:lang="en">Couldn't start the session in {0} with {1}: {2}</source>
        <target>Не вдалося розпочати сесію в {0} з {1}: {2}</target>
      </trans-unit>
      <trans-unit id="chatWindowComposer.copyPrompt">
        <source xml:lang="en">Copy Prompt</source>
        <target>Скопіювати запит</target>
      </trans-unit>
      <trans-unit id="chatWindowComposer.noWorkspace">
        <source xml:lang="en">No Workspace</source>
        <target>Немає робочого простору</target>
      </trans-unit>
      <trans-unit id="chatWindowComposer.promptCopiedInstead">
        <source xml:lang="en">The composer can't take the prompt back now, so it was copied to the clipboard instead.</source>
        <target>Композитор не може забрати підказку назад зараз, тому вона була скопійована в буфер обміну.</target>
      </trans-unit>
      <trans-unit id="chatWindowComposer.promptRestored">
        <source xml:lang="en">The prompt of the session that couldn't start is back in the composer.</source>
        <target>Підказка сесії, яка не змогла розпочатися, знову в композиторі.</target>
      </trans-unit>
      <trans-unit id="chatWindowComposer.restorePrompt">
        <source xml:lang="en">Restore Prompt</source>
        <target>Відновити підказку</target>
      </trans-unit>
    </body>
