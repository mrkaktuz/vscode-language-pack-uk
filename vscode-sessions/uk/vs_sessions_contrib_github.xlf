  <file original="src/vs/sessions/contrib/github/browser/createSessionFromPullRequestAction" source-language="en" datatype="plaintext" target-language="uk">
    <body>
      <trans-unit id="createSessionFromPullRequest.error">
        <source xml:lang="en">Failed to create a session from pull request #{0}: {1}</source>
        <target>Не вдалося створити сесію з запиту на злиття #{0}: {1}</target>
      </trans-unit>
      <trans-unit id="createSessionFromPullRequest.fetching">
        <source xml:lang="en">Fetching pull request...</source>
        <target>Отримання запиту на злиття...</target>
      </trans-unit>
      <trans-unit id="createSessionFromPullRequest.groupLoadError">
        <source xml:lang="en">Pull requests loaded, but the {0} group could not be resolved: {1}</source>
        <target>Запити на злиття завантажено, але групу {0} не вдалося розпізнати: {1}</target>
      </trans-unit>
      <trans-unit id="createSessionFromPullRequest.loadError">
        <source xml:lang="en">Failed to load pull requests: {0}</source>
        <target>Не вдалося завантажити запити на злиття: {0}</target>
      </trans-unit>
      <trans-unit id="createSessionFromPullRequest.noGitHubRepository">
        <source xml:lang="en">No GitHub repository could be resolved for this workspace.</source>
        <target>Не вдалося знайти репозиторій GitHub для цього робочого простору.</target>
      </trans-unit>
      <trans-unit id="createSessionFromPullRequest.placeholder">
        <source xml:lang="en">Choose a pull request</source>
        <target>Виберіть запит на злиття</target>
      </trans-unit>
      <trans-unit id="createSessionFromPullRequest.resolveGitHubRepositoryError">
        <source xml:lang="en">Failed to resolve the GitHub repository: {0}</source>
        <target>Не вдалося вирішити репозиторій GitHub: {0}</target>
      </trans-unit>
      <trans-unit id="newSessionFromPullRequest">
        <source xml:lang="en">New Session from Pull Request</source>
        <target>Нова сесія з Pull Request</target>
      </trans-unit>
      <trans-unit id="newSessionFromPullRequest.resolvingRepository">
        <source xml:lang="en">Resolving GitHub repository...</source>
        <target>Вирішення репозиторію GitHub...</target>
      </trans-unit>
      <trans-unit id="newSessionFromPullRequest.title">
        <source xml:lang="en">New Session from Pull Request</source>
        <target>Нова сесія з запиту на злиття</target>
      </trans-unit>
      <trans-unit id="pullRequests.assignedToMe">
        <source xml:lang="en">Assigned to Me</source>
        <target>Призначено мені</target>
      </trans-unit>
      <trans-unit id="pullRequests.waitingForMyReview">
        <source xml:lang="en">Waiting for My Review</source>
        <target>Чекаю на мій відгук</target>
      </trans-unit>
    </body>
  </file>
