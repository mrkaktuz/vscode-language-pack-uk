  <file original="src/vs/sessions/contrib/github/browser/pullRequestPicker" source-language="en" datatype="plaintext" target-language="uk">
    <body>
      <trans-unit id="pullRequest.ariaLabel">
        <source xml:lang="en">Pull request #{0}, {1}, by {2}, updated {3}, {4} additions and {5} deletions</source>
        <target>Запит на злиття #{0}, {1}, від {2}, оновлено {3}, {4} додавань та {5} видалень</target>
      </trans-unit>
      <trans-unit id="pullRequest.context.tooltip">
        <source xml:lang="en">Pull request #{0} by @{1}</source>
        <target>Запит на злиття #{0} від @{1}</target>
      </trans-unit>
      <trans-unit id="pullRequest.detail">
        <source xml:lang="en">@{0} · updated {1} · +{2} -{3}</source>
        <target>@{0} · оновлено {1} · +{2} -{3}</target>
      </trans-unit>
      <trans-unit id="pullRequest.sessionReady">
        <source xml:lang="en">Session ready. Pull request #{0} is checked out and attached.</source>
        <target>Сесію готово. Запит на злиття #{0} перевірено та прикріплено.</target>
      </trans-unit>
      <trans-unit id="pullRequests.assignedToMe">
        <source xml:lang="en">Assigned to Me</source>
        <target>Призначено мені</target>
      </trans-unit>
      <trans-unit id="pullRequests.other">
        <source xml:lang="en">Other Pull Requests</source>
        <target>Інші запити на злиття</target>
      </trans-unit>
      <trans-unit id="pullRequests.waitingForMyReview">
        <source xml:lang="en">Waiting for My Review</source>
        <target>Чекаю на мій відгук</target>
      </trans-unit>
    </body>
